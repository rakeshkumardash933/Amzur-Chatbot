# Core
APP_NAME=Amzur Chat
DEBUG=False
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/amzur_chat

# Auth
JWT_SECRET=your-jwt-secret-here
# Optional backward compatibility key (can be omitted)
SECRET_KEY=your-secret-key-here
JWT_EXPIRE_MINUTES=30

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# LiteLLM Proxy
LITELLM_PROXY_URL=https://litellm.amzur.com/v1
LITELLM_API_KEY=your-litellm-api-key
LITELLM_VIRTUAL_KEY=
LITELLM_USER_ID=
LITELLM_DEPARTMENT=Development
LITELLM_ENVIRONMENT=development
LLM_MODEL=gpt-4o
LITELLM_EMBEDDING_MODEL=text-embedding-3-large

# Google Gemini API
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-pro

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
